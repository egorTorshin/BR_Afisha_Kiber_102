# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Строка подключения к реляционной БД
# Для Docker Compose используется PostgreSQL:
# В Compose DATABASE_URL формируется из отдельных ролей; для CLI задайте его отдельно.
# DATABASE_URL=postgresql://afisha_user:<password>@db:5432/afisha_db
# Для локального запуска без контейнера PostgreSQL поддерживается SQLite:
# DATABASE_URL=sqlite:///data/afisha_local.db

# Параметры PostgreSQL и порты Docker Compose; каждому сервису нужен отдельный пароль.
POSTGRES_USER=afisha_user
POSTGRES_PASSWORD=
API_DB_PASSWORD=
BOT_DB_PASSWORD=
MAINTENANCE_DB_PASSWORD=
POSTGRES_DB=afisha_db
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000

# Список Telegram user_id модераторов/администраторов (через запятую)
ADMIN_USER_IDS=

# Веб-админка: задайте пароль текстом только в локальном .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Альтернатива: хеш пароля вместо ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Необязательный отдельный ключ сессий; без него используется RATE_LIMIT_SECRET.
# ADMIN_SECRET=
# Публичный адрес сайта, строго в формате scheme://host[:port].
WEB_ORIGIN=http://localhost:3000
# Отдельный секрет для подписанных анонимных cookie ограничения запросов (от 32 символов).
RATE_LIMIT_SECRET=
# Дополнительная роль модератора: карточки и заявки, без импорта и журнала.
MODERATOR_USERNAME=
MODERATOR_PASSWORD=
# MODERATOR_PASSWORD_HASH=
# true для production за HTTPS; false только для локальной разработки по HTTP.
ADMIN_COOKIE_SECURE=true

# Ограничение частоты запросов от одного пользователя (запросов в минуту)
RATE_LIMIT_PER_MINUTE=30

# Срок хранения неактивных или созданных подписок (в днях)
SUBSCRIPTION_RETENTION_DAYS=180
FEEDBACK_RETENTION_DAYS=365
RAW_RETENTION_DAYS=365
IMPORT_REPORT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=2000

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Опорная дата для демонстрационных сценариев (опционально, формат YYYY-MM-DD, пусто = текущая системная дата)
REFERENCE_DATE=2026-11-13

# Разрешённые CORS origins через запятую; пусто = cross-origin доступ не разрешён
CORS_ORIGINS=

# Время кеширования успешных публичных GET, в секундах
PUBLIC_CACHE_MAX_AGE=60
