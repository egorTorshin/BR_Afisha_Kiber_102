# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
MAX_BOT_ENABLED=false
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PORT=18081
REDIS_URL=
JEV_CACHE_TTL_SECONDS=300
JEV_PROMPT_VERSION=v1
CATALOG_CACHE_VERSION=v1
GKZ_COLLECTION_INTERVAL_SECONDS=21600
GKZ_COLLECTION_TIMEOUT_SECONDS=20
GKZ_COLLECTION_RETRIES=3
VENUE_COLLECTION_INTERVAL_SECONDS=21600
# JSON-конфигурация источников; новый venue можно добавить без изменения Python.
VENUE_SOURCES_CONFIG=config/event_sources.json
VENUE_COLLECTION_TIMEOUT_SECONDS=20
KASSIR_COLLECTION_INTERVAL_SECONDS=21600
KASSIR_COLLECTION_TIMEOUT_SECONDS=20
KASSIR_COLLECTION_RETRIES=2

# Строка подключения к реляционной БД
# Для Docker Compose используется PostgreSQL:
# В Compose DATABASE_URL формируется из отдельных ролей; для CLI задайте его отдельно.
# DATABASE_URL=postgresql://afisha_user:<password>@db:5432/afisha_db
# Для локального запуска без контейнера PostgreSQL поддерживается SQLite:
# DATABASE_URL=sqlite:///data/afisha_local.db

# Параметры PostgreSQL и порты Docker Compose; каждому сервису нужен отдельный пароль.
POSTGRES_USER=afisha_user
POSTGRES_PASSWORD=afisha_postgres_demo_2026
API_DB_PASSWORD=afisha_api_demo_2026
BOT_DB_PASSWORD=afisha_bot_demo_2026
MAINTENANCE_DB_PASSWORD=afisha_maintenance_demo_2026
POSTGRES_DB=afisha_db
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000

# Список Telegram user_id модераторов/администраторов (через запятую)
ADMIN_USER_IDS=

# Веб-админка: задайте пароль текстом только в локальном .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=afisha_admin_demo_2026
# Альтернатива: хеш пароля вместо ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Необязательный отдельный ключ сессий; без него используется RATE_LIMIT_SECRET.
# ADMIN_SECRET=
# Публичный адрес сайта, строго в формате scheme://host[:port].
WEB_ORIGIN=http://localhost:3000
# Отдельный секрет для подписанных анонимных cookie ограничения запросов (от 32 символов).
RATE_LIMIT_SECRET=afisha_demo_rate_limit_secret_2026_change_me
# Дополнительная роль модератора: карточки и заявки, без импорта и журнала.
MODERATOR_USERNAME=
MODERATOR_PASSWORD=
# MODERATOR_PASSWORD_HASH=
# true для HTTPS в production
ADMIN_COOKIE_SECURE=false

# Ограничение частоты запросов от одного пользователя (запросов в минуту)
RATE_LIMIT_PER_MINUTE=30

# Срок хранения неактивных или созданных подписок (в днях)
SUBSCRIPTION_RETENTION_DAYS=180
FEEDBACK_RETENTION_DAYS=365
RAW_RETENTION_DAYS=365
IMPORT_REPORT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=2000

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Опорная дата демонстрационного каталога (формат YYYY-MM-DD).
REFERENCE_DATE=

# Разрешённые CORS origins через запятую; пусто = cross-origin доступ не разрешён
CORS_ORIGINS=

# Время кеширования успешных публичных GET, в секундах
PUBLIC_CACHE_MAX_AGE=60

# Агентный API. По умолчанию модели выключены, работает детерминированный fallback.
AI_MODE=no-ai
ADAPTIVE_AGENT_ENABLED=false
STRUCTURED_DEEP_ENABLED=false
JEV_ENABLED=false
JEV_ENDPOINT=
JEV_BASE_URL=
JEV_MODEL=qwen2.5-1.5b-router
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=5
JEV_CONFIDENCE_THRESHOLD=0.7
LOCAL_LLM_BASE_URL=
LIGHT_LLM_MODEL=qwen2.5-3b-local
LIGHT_LLM_CONFIDENCE_THRESHOLD=0.75
LIGHT_LLM_TIMEOUT_SECONDS=25
LIGHT_LLM_MAX_TOKENS=384
HEAVY_LLM_MODEL=qwen2.5-3b-local
HEAVY_LLM_TIMEOUT_SECONDS=90
HEAVY_LLM_MAX_TOKENS=512
HEAVY_LLM_CONTEXT_WINDOW=4096
HEAVY_LLM_TOP_N=8
HEAVY_SINGLE_PASS=false
HEAVY_COMPACT_CONTINUATION=false
AGENT_DIALOGUE_TTL_DAYS=30
# Maximum model spend per conversation and per user per UTC day (USD).
AGENT_DIALOGUE_COST_LIMIT_USD=1.00
AGENT_DAILY_USER_COST_LIMIT_USD=5.00
# Необязательные цены в USD за 1 млн входных/выходных токенов.
# AGENT_MODEL_PRICES_JSON={"model-name":{"input":"0","output":"0"}}

# Каталог GGUF-весов для compose.local-ai.yml; веса не входят в Git/образ.
MODELS_DIR=./models

# Распознавание речи через Groq Whisper. Без ключа голосовой ввод возвращает понятную ошибку.
GROQ_API_KEY=
SPEECH_MAX_BYTES=20971520
SPEECH_MAX_DURATION_SEC=20
SPEECH_TIMEOUT_SECONDS=30
# Username бота без @ для кнопки входа на сайте. Настройте домен через BotFather /setdomain.
TELEGRAM_BOT_USERNAME=

# Grafana/Prometheus слушают только localhost. Grafana по умолчанию использует
# RATE_LIMIT_SECRET как пароль администратора; задайте отдельный пароль при желании.
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3002
# PROMETHEUS_PORT=9090
